   ============================================================ */

.nova-status,
.nova-badge,
.status-badge {
    display: inline-flex;

    align-items: center;
    gap: 6px;

    min-height: 24px;

    padding:
        3px 9px;

    border-radius:
        999px;

    border:
        1px solid var(--nova-border);

    background:
        rgba(255, 255, 255, 0.025);

    color:
        var(--nova-text-secondary);

    font-size:
        12px;

    font-weight:
        600;
}

