.nova-app-icon,
.nova-icon-container {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    border-radius:
        var(--nova-radius-md);

    background:
        rgba(99, 102, 241, 0.10);

    border:
        1px solid rgba(99, 102, 241, 0.20);

    color:
        var(--nova-primary);

    transition:
        transform var(--nova-transition-fast),
        background var(--nova-transition-fast),
        border-color var(--nova-transition-fast);
}

.nova-icon:hover,
.nova-app-icon:hover,
.nova-icon-container:hover {
