}


/* ============================================================
   30. SETTINGS
   ============================================================ */

.nova-settings,
[data-subsystem="settings"] {
    --nova-local-accent: var(--nova-settings);
    --nova-local-soft: var(--nova-settings-soft);
    --nova-local-border: var(--nova-settings-border);
}

.nova-settings .nova-icon,
[data-subsystem="settings"] .nova-icon {
    background:
        var(--nova-settings-soft);

    border-color:
        var(--nova-settings-border);

    color:
        var(--nova-settings);
}


/* ============================================================
   31. PROGRESS BARS
   ============================================================ */

.nova-progress,
.progress-bar,
.progress {
    background:
        rgba(255, 255, 255, 0.06) !important;

    border:
        1px solid rgba(255, 255, 255, 0.04);

    border-radius:
        999px;

    overflow:
        hidden;
}

.nova-progress > *,
.progress-bar > *,
.progress > * {
    background:
        linear-gradient(
            90deg,
            var(--nova-primary),
            var(--nova-primary-strong)
        ) !important;

    border-radius:
        inherit;

    box-shadow:
        0 0 12px rgba(99, 102, 241, 0.16);
}


/* ============================================================
   32. DIVIDERS
   ============================================================ */

hr,
.nova-divider {
    border:
        0 !important;

    border-top:
        1px solid var(--nova-border-soft) !important;

    opacity:
        1;
}


/* ============================================================
   33. TOOLTIPS / POPOVERS
   ============================================================ */

.nova-tooltip,
.nova-popover,
[role="tooltip"] {
    background:
        rgba(18, 24, 42, 0.96) !important;

    border:
        1px solid var(--nova-border-strong) !important;

    color:
        var(--nova-text) !important;

    border-radius:
        var(--nova-radius-sm) !important;

    box-shadow:
        var(--nova-shadow-md) !important;

    backdrop-filter:
        blur(18px);

    -webkit-backdrop-filter:
        blur(18px);
}


/* ============================================================
   34. MODALS / OVERLAYS
   ============================================================ */

.nova-modal-backdrop,
.nova-overlay,
.modal-backdrop {
    background:
        rgba(3, 6, 14, 0.62) !important;

    backdrop-filter:
        blur(5px);

    -webkit-backdrop-filter:
        blur(5px);
}

.nova-modal,
.modal {
    background:
        linear-gradient(
            145deg,
            rgba(23, 30, 50, 0.98),
            rgba(14, 20, 35, 0.98)
        ) !important;

    border:
        1px solid var(--nova-border-strong) !important;

    border-radius:
        var(--nova-radius-lg) !important;

    box-shadow:
        var(--nova-shadow-lg) !important;

    color:
        var(--nova-text) !important;
}


/* ============================================================
   35. NOTIFICATION CENTER
   ============================================================ */

.nova-notification-center,
.nova-notification-panel,
.notification-center {
    background:
        rgba(18, 24, 42, 0.94) !important;

    border:
        1px solid var(--nova-border-strong) !important;

    border-radius:
        var(--nova-radius-lg) !important;

    box-shadow:
        var(--nova-shadow-lg) !important;

    backdrop-filter:
        blur(24px) saturate(130%);

    -webkit-backdrop-filter:
        blur(24px) saturate(130%);
}

.nova-notification,
.notification-item {
    background:
        rgba(255, 255, 255, 0.025) !important;

    border:
        1px solid var(--nova-border-soft) !important;

    border-radius:
        var(--nova-radius-md) !important;

    color:
        var(--nova-text-secondary) !important;
}

.nova-notification:hover,
.notification-item:hover {
    background:
        rgba(99, 102, 241, 0.065) !important;

    border-color:
        rgba(99, 102, 241, 0.18) !important;
}


/* ============================================================
   36. SYSTEM LOGS
   ============================================================ */

.nova-log-entry,
.system-log-entry,
.log-entry {
    background:
        rgba(8, 13, 24, 0.34) !important;

    border-bottom:
        1px solid var(--nova-border-soft) !important;

    color:
        var(--nova-text-secondary);
}

.nova-log-entry:hover,
.system-log-entry:hover,
.log-entry:hover {
    background:
        rgba(99, 102, 241, 0.035) !important;
}


/* ============================================================
   37. TERMINAL VISUAL LANGUAGE
   ============================================================ */

.nova-terminal,
.terminal-app {
    --terminal-green: var(--nova-terminal);
}

.nova-terminal pre,
.nova-terminal code,
.terminal-app pre,
.terminal-app code {
    font-family:
        "Cascadia Code",
        "Cascadia Mono",
        "JetBrains Mono",
        "Fira Code",
        Consolas,
        monospace;
}

.nova-terminal .prompt,
.terminal-app .prompt {
    color:
        var(--nova-terminal) !important;
}

.nova-terminal .command,
.terminal-app .command {
    color:
        var(--nova-text) !important;
}


/* ============================================================
   38. SCROLLBARS
   ============================================================ */

* {
    scrollbar-width:
        thin;

    scrollbar-color:
        rgba(148, 163, 184, 0.22)
        transparent;
}

*::-webkit-scrollbar {
    width: 9px;
    height: 9px;
}

*::-webkit-scrollbar-track {
    background:
        transparent;
}

*::-webkit-scrollbar-thumb {
    background:
        rgba(148, 163, 184, 0.20);

    border:
        2px solid transparent;

    background-clip:
        padding-box;

    border-radius:
        999px;
}

*::-webkit-scrollbar-thumb:hover {
    background:
        rgba(148, 163, 184, 0.32);

    border:
        2px solid transparent;

    background-clip:
        padding-box;
}


/* ============================================================
   39. SELECTION
   ============================================================ */

::selection {
    background:
        rgba(99, 102, 241, 0.30);

    color:
        #ffffff;
}


/* ============================================================
   40. LINKS
   ============================================================ */

a {
    color:
        #818cf8;

    transition:
        color var(--nova-transition-fast);
}

a:hover {
    color:
        #a5b4fc;
}


/* ============================================================
   41. DISABLED ELEMENTS
   ============================================================ */

button:disabled,
input:disabled,
textarea:disabled,
select:disabled {
    opacity:
        0.48 !important;

    cursor:
        not-allowed !important;

    transform:
        none !important;
}


/* ============================================================
   42. RESIZE HANDLES
   ============================================================ */

.nova-resize-handle,
.nova-window-resize-handle {
    background:
        transparent !important;
}

.nova-resize-handle:hover,
.nova-window-resize-handle:hover {
    background:
        rgba(99, 102, 241, 0.045) !important;
}


/* ============================================================
   43. MOBILE / SMALL WINDOWS
   ============================================================ */

@media (max-width: 800px) {
    .nova-window {
        left:
            12px !important;

        top:
            12px !important;

        width:
            calc(100vw - 24px) !important;

        height:
            calc(100vh - 90px) !important;

        min-width:
            0 !important;

        min-height:
            0 !important;

        border-radius:
            var(--nova-radius-md) !important;
    }

    .nova-window-titlebar {
        border-radius:
            var(--nova-radius-md)
            var(--nova-radius-md)
            0
            0 !important;
    }

    .nova-taskbar-center {
        display:
            none !important;
    }

    .nova-taskbar {
        height:
            54px;
    }
}


/* ============================================================
   44. LAUNCHER MOBILE
   ============================================================ */

@media (max-width: 560px) {
    .nova-app-launcher {
        left:
            12px !important;

        bottom:
            68px !important;

        width:
            calc(100vw - 24px) !important;

        max-width:
            calc(100vw - 24px) !important;

        border-radius:
            var(--nova-radius-lg) !important;
    }
}


/* ============================================================
   45. REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration:
            0.01ms !important;

        animation-iteration-count:
            1 !important;

        scroll-behavior:
            auto !important;

        transition-duration:
            0.01ms !important;
    }
}


/* ============================================================
   46. LIGHT THEME COMPATIBILITY
   ============================================================ */

[data-theme="light"],
.light-theme {
    --nova-bg-0: #eef2f8;
    --nova-bg-1: #f5f7fb;
    --nova-bg-2: #ffffff;

    --nova-surface: #ffffff;
    --nova-surface-strong: #f8faff;
    --nova-surface-soft: #f1f4f9;
    --nova-surface-highlight: #e9edf5;

    --nova-text: #172033;
    --nova-text-secondary: #4c5870;
    --nova-text-muted: #68758b;
    --nova-text-subtle: #8792a5;

    --nova-border: #dce2ec;
    --nova-border-soft: rgba(71, 85, 105, 0.10);
    --nova-border-strong: #c8d1df;
}

[data-theme="light"] body,
.light-theme body {
    background:
        linear-gradient(
            145deg,
            #eef2f8,
            #f8faff
        );
}

[data-theme="light"] .nova-taskbar,
.light-theme .nova-taskbar {
    background:
        rgba(248, 250, 255, 0.88) !important;

    border-top-color:
        rgba(71, 85, 105, 0.12) !important;

    box-shadow:
        0 -8px 30px rgba(15, 23, 42, 0.08) !important;
}

[data-theme="light"] .nova-window,
.light-theme .nova-window {
    box-shadow:
        0 18px 48px rgba(15, 23, 42, 0.16),
        0 3px 12px rgba(15, 23, 42, 0.08) !important;
}


/* ============================================================
   47. FINAL LAYER SAFETY
   ============================================================ */

/*
 * These rules intentionally preserve the working NovaOS
 * window-management architecture.
 */

.nova-window-layer {
    z-index:
        500 !important;
}

.nova-window {
    z-index:
        600 !important;
}

.nova-window.maximized {
    z-index:
        700 !important;
}

.nova-window-titlebar {
    position:
        relative;

    z-index:
        701;
}

.nova-window-controls {
    position:
        relative;

    z-index:
        702;
}


/* ============================================================
   END — NOVAOS VISUAL OVERHAUL
   ============================================================ */