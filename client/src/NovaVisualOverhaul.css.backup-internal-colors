.nova-badge.success,
.status-badge.success {
    background:
        var(--nova-success-soft) !important;

    border-color:
        var(--nova-success-border) !important;

    color:
        var(--nova-success) !important;
}

.nova-status.warning,
.nova-badge.warning,
.status-badge.warning {
    background:
        var(--nova-warning-soft) !important;

